# Codex-Platform local configuration
# Copy to .env for a disposable dev shell. Keep real local notes in .env.local.

HOST=127.0.0.1
PORT=8787
DEMO_MODE=false

WORKSPACE_ROOT=/absolute/path/to/repo
WORKSPACE_ROOTS=/absolute/path/to/repo
CODEX_PLATFORM_DATA_DIR=/absolute/path/to/repo/.codex-platform
CODEX_HOME=/absolute/path/to/.codex

CODEX_BIN=codex
CODEX_ARGS=app-server
CODEX_CLIENT_NAME=codex_platform
CODEX_CLIENT_TITLE=Codex-Platform

# Required when exposing on a non-loopback host or when running real mode on HF Spaces.
CODEX_PLATFORM_AUTH_TOKEN=
CODEX_PLATFORM_ALLOW_UNAUTHENTICATED=false
CODEX_PLATFORM_OPS_TOKEN=
CODEX_PLATFORM_ADMIN_ENABLED=false
CODEX_PLATFORM_ADMIN_TOKEN=

CODEX_APPROVAL_POLICY=unlessTrusted
CODEX_SANDBOX=workspaceWrite
CODEX_EFFORT=medium
CODEX_SUMMARY=concise
