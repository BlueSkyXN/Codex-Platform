# Hugging Face Space Variables/Secrets for Codex-Platform
# Public demo Spaces need no secrets. Real mode must run as Private or Protected.

# HF Variables
DEMO_MODE=auto
HOST=0.0.0.0
PORT=7860
CODEX_PLATFORM_HF_SPACE=true
CODEX_PLATFORM_HF_STORAGE_ROOT=/data
WORKSPACE_ROOT=/data/workspace
WORKSPACE_ROOTS=/data/workspace
CODEX_PLATFORM_DATA_DIR=/data/codex-platform
CODEX_HOME=/data/codex-home
CODEX_BIN=codex
CODEX_ARGS=app-server

# HF Secrets for real mode
CODEX_PLATFORM_AUTH_TOKEN=<long-random-token>
CODEX_PLATFORM_OPS_TOKEN=<long-random-ops-token>
OPENAI_API_KEY=<optional-if-api-key-auth-is-used>

# Optional admin control plane. Keep disabled unless you are in a controlled
# Private/Protected Space and need the whitelisted admin actions.
CODEX_PLATFORM_ADMIN_ENABLED=false
CODEX_PLATFORM_ADMIN_TOKEN=<long-random-admin-token-if-enabled>

# Compatibility aliases still accepted by the app:
# CODEX_WEB_AUTH_TOKEN
# CODEX_WEB_DATA_DIR
# CODEX_WEB_HF_SPACE
